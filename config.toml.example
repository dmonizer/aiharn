# Aiharn configuration. Local file paths (system prompts, key files, known_hosts)
# resolve relative to THIS file's directory. ${VAR} interpolates from the
# environment (a missing referenced variable is fatal). Tilde (~) expands only
# for LOCAL paths. Secret-bearing fields (api_key, password) are redacted from
# all error/log output.

# Default: the user's home directory (~). Transcripts go under ~/transcripts/.
# aiharn_home = "~"
# Example override: aiharn_home = "~/.local/share/aiharn"

# TUI shortcut defaults. Change any value to remap that action.
# Keys: f1-f12, ctrl+letter, alt+letter, or ctrl+arrow. Ctrl+C is reserved.
[shortcuts]
toggle_actions = "f9"       # ask/all; for example, change to "ctrl+a"
toggle_thinking = "f10"
cycle_shell = "ctrl+s"
grow_input = "ctrl+up"
shrink_input = "ctrl+down"
insert_newline = "ctrl+j"

[models.deepseek_flash]
provider = "openai_responses"          # required; no default or silent fallback
base_url = "https://api.deepseek.com" # required; no default
api_key  = "${DEEPSEEK_API_KEY}"       # required; no default; keep secrets out of this file
model    = "deepseek-v4-flash"         # required; no default
reasoning_effort = ""                 # default: provider/model decides; "none" requests off when supported
reasoning_summary = ""                # default: no summary; Responses API: auto|concise|detailed

[models.zai_glm]
provider = "openai_chat_completions"
base_url = "https://api.z.ai/api/paas/v4"
api_key  = "${ZAI_API_KEY}"
model    = "glm-5.3"

[models.zai_glm_flash]
provider = "openai_chat_completions"
base_url = "https://api.z.ai/api/paas/v4"
api_key  = "${ZAI_API_KEY}"
model    = "glm-5.3-flash"


# Execution channels. The first one is the default; overridable via --channel.
#
# When user, auth, and known_hosts are ALL unset/empty, `host` is treated as an
# OpenSSH ~/.ssh/config alias: HostName, Port, User, and IdentityFile are
# resolved from that file (IdentityFile is optional — if omitted, auth falls
# back to the SSH agent), and known_hosts defaults to ~/.ssh/known_hosts.
[[channels]]
name = "sf"                 # required; no default
type = "ssh"               # default
host = "sf"                # required for SSH; no default
port = 22                  # default
user = ""                  # default: unset; SSH alias resolves it
auth = { key_file = "", password = "" } # default: neither set; SSH alias resolves auth
known_hosts = ""           # default: unset; SSH alias resolves ~/.ssh/known_hosts
insecure = false           # default; true explicitly skips host-key verification
keep_alive = true          # default; false creates one connection per session
default_shell = "/bin/bash" # default
remote_command = ""        # default: use default_shell; e.g. "/bin/bash" overrides it
# working_dir is unset by default (no directory override).
# working_dir = "/sec/root/ai-work/${agent.type}-${agent.id}" # optional remote template
# To configure SSH without an alias, set user, one auth value, and known_hosts.
# Example: auth = { key_file = "~/.ssh/id_ed25519" } (local path; tilde expands)

# A local channel runs commands on this machine. It needs no remote host,
# user, key_file, password, or known_hosts. Point an agent at it with
# `channel = "local"` (or pass --channel local).
[[channels]]
name = "local"
type = "local"
default_shell = "/bin/bash"

[agents.main]
model = "zai_glm"     # required; validated at startup
# description = "" # default: empty; shown by list_subagent_types when provided
description = "General coordinator; delegates planning and operator tasks"
system_prompt = "prompts/main_pentester.md"
# channel = "" # default: first channel; explicit "sf" is equivalent here
channel = "sf"
# working_dir is unset by default; an agent override takes precedence over its channel's.
# working_dir = "/sec/root/ai-work/${agent.type}-${agent.id}"
# tools = "none" # default; also accepts "all" or a tool-name list
tools = "all"
# allow_subagents = false # default
allow_subagents = true

[agents.planner]
model = "zai_glm"
description = "Plans investigations and breaks work into tasks"
system_prompt = "prompts/planner_pentester.md"
channel = "sf"
tools = "none"
allow_subagents = true

[agents.operator]
model = "deepseek_flash"
description = "Performs scoped execution and hands findings back"
system_prompt = "prompts/operator_pentester.md"
channel = "sf"
tools = ["execute_command"]
allow_subagents = false

[limits] # All values below are defaults.
max_agent_depth = 2            # top-level = depth 0
max_open_agents = 8            # counts every non-closed agent, including idle
command_timeout = "30s"        # execution command timeout
command_output_bytes = 262144  # raw stdout+stderr cap per command (bytes)
tool_result_bytes = 65536      # max model-visible tool result (bytes)
inbox_depth = 32               # per-agent interim-message queue
event_capacity = 256           # agent->TUI event channel
request_timeout = "60s"        # provider request timeout
transcript_max_items = 200     # retained conversation items (0 = default)
transcript_max_bytes = 1048576 # retained conversation content bytes (0 = default)

[approval]
mode = "ask"                   # default; alternative: "allow-all"

# Optional current-session HTTP API. The values below are all defaults, so the
# API stays disabled. Every value can be overridden with the
# matching --api-* flag. AIHARN_API_TOKEN overrides token; prefer interpolation
# or the environment variable instead of committing a literal secret.
[api]
listen = ""               # default: disabled; e.g. "127.0.0.1:7331"
token = ""                # default; set a secret for non-loopback listening
allow_origins = []        # default: no cross-origin frontend access
only = false             # default: run the terminal UI; true requires listen
max_sessions = 8         # default; counts the default session; 0 uses the built-in default
